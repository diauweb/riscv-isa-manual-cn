# ==============================================================================
# riscv-isa-manual-cn — personal settings. `bun run setup` copies this file to
# `.env` (gitignored) if neither `.env` nor `.env.local` exists. Blank values
# are ignored, so unused lines are harmless.
#
# Precedence: CLI flags > --env-file > shell env (CI inputs / secrets / vars)
#             > DOTENV > .env.local > .env > built-in defaults
# Inspect the result any time:  bun run config
# ==============================================================================

# --- Upstream & Translation ---------------------------------------------------
# Git URL, local clone path, or `fixture` (default: official riscv-isa-manual)
UPSTREAM_REPO=
# Public repository URL used for upstream links (derived from UPSTREAM_REPO if unset)
UPSTREAM_REPO_URL=
# Provider: openai | deepseek | google | anthropic | mock (default: openai)
AI_PROVIDER=
# Model identifier (leave blank to use provider default)
AI_MODEL=

# --- LLM API keys -------------------------------------------------------------
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=

# Optional gateway / proxy base URLs
AI_BASE_URL=
OPENAI_BASE_URL=
DEEPSEEK_BASE_URL=
GOOGLE_GENERATIVE_AI_BASE_URL=
ANTHROPIC_BASE_URL=

# Optional reasoning effort: none | minimal | low | medium | high | xhigh
AI_REASONING_EFFORT=
# Optional parallel LLM chapter batches (default: 1; shared units are never translated twice)
AI_CONCURRENCY=

# Optional soft token caps for chapter/pass splitting guidance only — not enforced in AI API requests (defaults: 272000 input / 728000 output)
AI_MAX_INPUT_TOKENS=
AI_MAX_OUTPUT_TOKENS=

# --- Sync & Publish -----------------------------------------------------------
# Earliest upstream commit date to index on initial sync (YYYY-MM-DD)
BASELINE_DATE=
# Budget caps before checkpointing and exiting cleanly
SYNC_MAX_MINUTES=
SYNC_MAX_BATCHES=
# Auto-commit synced checkpoints in DATA_DIR (default: true)
SYNC_COMMIT=
# Stop immediately on first LLM error instead of writing stub TOMLs (default: true in CI, false locally)
SYNC_FAIL_FAST=
# Set `false` to disable pushing in `job:sync` / `publish:data` (default: true; local push still requires `--yes`)
PUBLISH=

# --- LangSmith debugging / tracing (optional) -----------------------------------
LANGSMITH_TRACING=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_AGENT_ID=
LANGSMITH_AGENT_ENVIRONMENT=local
LANGSMITH_WORKSPACE_ID=
# Optional legacy project-based routing (used when LANGSMITH_AGENT_ID is unset):
LANGSMITH_PROJECT=

# --- Data repository ----------------------------------------------------------
# owner/name of the real data repo; `bun run workspace` clones it into ./.work/data
# instead of starting from templates/data-repo.
DATA_REPO=
# Public data repository URL embedded in site metadata (derived from DATA_REPO if unset)
DATA_REPO_URL=
# Or any git URL / local path to clone from (e.g. ../riscv-isa-manual-cn-data), or `template`.
DATA_REMOTE=
# Use an existing checkout in place instead of a throwaway clone under ./.work/data.
DATA_DIR=
# Token for cloning/pushing over HTTPS (CI uses this; locally your git credentials work).
DATA_REPO_TOKEN=

# --- Workspace ----------------------------------------------------------------
# Root for upstream mirror/fixture and default data dir (./.work/data) (default ./.work)
WORK_DIR=
# Mirror remote upstreams into WORK_DIR/upstream.git (default true)
UPSTREAM_CACHE=
# Worker threads for parallel parsing, validation, and rendering (default: min(8, CPUs))
JOBS=
# Output directory for `bun run build-site` (default: ./packages/viewer/public/data)
SITE_OUT_DIR=
# Output directory for `bun run build` / `bun run preview` (default: ./packages/viewer/dist)
DIST_DIR=
# Verbosity level (`1`..`3`) and stack-trace flag (`1`) for CLI diagnostics
VERBOSE=
DEBUG=

# --- Viewer ---------------------------------------------------------------------
VIEWER_PORT=
# Base URL path passed to Vite (default: `./`)
VIEWER_BASE_PATH=
# Override fetched data base URL at build time (default: `./data`)
VITE_DATA_URL=
